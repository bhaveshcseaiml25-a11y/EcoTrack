# Copy to .env and adjust. Variables are read from the process environment
# (export them, or use `set -a; source .env; set +a`).

# SQLite by default. For PostgreSQL install psycopg and use e.g.
# postgresql+psycopg://user:pass@localhost:5432/ecotrack
ECOTRACK_DATABASE_URL=sqlite:///./ecotrack.db

# Comma-separated list of frontend origins allowed by CORS
ECOTRACK_CORS_ORIGINS=http://localhost:3000

# Where citizen complaint images are stored
ECOTRACK_UPLOAD_DIR=./uploads

# Fictional city centre used for seed data and as the vehicle depot.
# Set these to match the coordinates used by the frontend map.
ECOTRACK_CITY_LAT=12.9716
ECOTRACK_CITY_LNG=77.5946

# Background fill simulation (toggle on/off from Settings > System in the UI)
ECOTRACK_SIM_INTERVAL_SECONDS=15
